---
source: crates/yanto-cli/src/ops/render.rs
expression: "render_unit(&params(), Some(Path::new(\"/home/deploy/.ssh\")))"
---
[Unit]
Description=Yanto VPS management
Documentation=https://github.com/kodin00/yanto
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/yanto serve --config /etc/yanto/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=45
KillMode=control-group
UMask=0077
LimitNOFILE=65536
Environment=HOME=/root
StateDirectory=yanto
StateDirectoryMode=0700
RuntimeDirectory=yanto
RuntimeDirectoryMode=0700

# --- sandboxing: Tier A (safe, always on) ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# --- Tier B (on; paths generated from config) ---
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/yanto /etc/cron.d -/etc/traefik/dynamic -/etc/frp -/home/deploy/.ssh

[Install]
WantedBy=multi-user.target
