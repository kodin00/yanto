# Yanto does not require an .env file. Copy this file only when you need an
# advanced deployment override; application settings are managed in the UI.
YANTO_VERSION=latest
PORT=8080
HOST_PROJECTS_ROOT=~/projects
SSH_SOURCE_DIR=~/.ssh

# Optional infrastructure/security overrides. When JWT_SECRET and
# WORKER_TOKEN_SECRET are empty, the container generates stable random values
# in the yanto_config volume.
POSTGRES_PASSWORD=yanto
JWT_SECRET=
WORKER_TOKEN_SECRET=
YANTO_SETUP_CODE=

# Legacy upgrades only. Existing ADMIN_USERNAME/ADMIN_PASSWORD values are
# migrated into the database owner when no account exists yet.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Optional network and worker overrides.
APP_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
MCP_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080
MCP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
WORKER_JOIN_TOKEN=
YANTO_MASTER_URL=http://127.0.0.1:8080
YANTO_WORKER_TOKEN=
YANTO_WORKER_NAME=

# FRP listener overrides.
FRP_BIND_PORT=7000
FRP_PORT_START=25560
FRP_PORT_END=25600
